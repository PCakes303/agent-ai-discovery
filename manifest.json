  "repository_url": "https://github.com/PCakes303/agent-ai-discovery",
  "default_branch": "main",
  "compatibility": [
    {
      "with": "resource-manifest",
      "range": "*",
      "tested": false
    },
    {
      "with": "schema-registry",
      "range": "*",
