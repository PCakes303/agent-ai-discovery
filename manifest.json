    }
  ],
  "dependencies": [
    {
      "id": "master",
      "constraint": "*",
      "kind": "contract"
    },
    {
      "id": "resource-manifest",
      "constraint": "*",
      "kind": "contract"
    },
    {
      "id": "schema-registry",
      "constraint": "*",
      "kind": "contract"
    },
    {
      "id": "identity-trust",
      "constraint": "*",
      "kind": "contract"
    }
