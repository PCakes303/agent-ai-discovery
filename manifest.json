{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PCakes303/agent-ai-discovery/blob/main/manifest.json",
  "manifest_version": "1.0.0",
  "id": "discovery",
  "name": "agent-ai-discovery",
  "visibility": "public",
  "maturity": "scaffolding",
